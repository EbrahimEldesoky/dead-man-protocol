# IBM Quantum API Key (get from https://quantum.ibm.com)
IBM_API_KEY=your_ibm_quantum_api_key_here

# Database (auto-configured by run.sh via Docker)
DATABASE_URL=postgresql://dmb_admin:dmb_quantum_password123@localhost:5440/quantum_vault?schema=public
