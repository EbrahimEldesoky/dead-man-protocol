            ],
            "type": "bool"
          },
          {
            "name": "is_cancelled",
            "docs": [
              "Whether the owner has cancelled this vault."
            ],
            "type": "bool"
          },
          {
            "name": "grace_period_seconds",
            "docs": [
              "Number of seconds after deadline before claims are allowed.",
              "Immutable after vault creation."
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed for signing."
            ],
