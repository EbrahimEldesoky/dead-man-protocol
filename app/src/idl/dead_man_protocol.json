          },
          {
            "name": "last_heartbeat",
            "docs": [
              "Unix timestamp of the last heartbeat (proof of life) from the owner."
            ],
            "type": "i64"
          },
          {
            "name": "deadline_seconds",
            "docs": [
              "Number of seconds of inactivity before the vault is considered triggered."
            ],
            "type": "i64"
          },
          {
            "name": "encrypted_will_cid",
            "docs": [
