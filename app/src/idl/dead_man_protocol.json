  "types": [
    {
      "name": "BeneficiaryAdded",
      "docs": [
        "Emitted when a beneficiary is added to a vault."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "wallet",
            "type": "pubkey"
          },
          {
            "name": "share_bps",
            "type": "u16"
          },
          {
            "name": "total_shares",
            "type": "u16"
          }
        ]
      }
    },
    {
      "name": "BeneficiaryRecord",
      "docs": [
        "On-chain account representing a single beneficiary of a vault.",
        "",
        "Derived as a PDA with seeds:",
        "`[b\"beneficiary\", vault.key().as_ref(), wallet.key().as_ref()]`.",
        "Each beneficiary has an allocated share (in bps) and an optional",
        "encrypted secret payload on IPFS."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "vault",
            "docs": [
              "The vault this beneficiary belongs to."
            ],
            "type": "pubkey"
          },
          {
            "name": "wallet",
            "docs": [
              "The wallet address of the beneficiary."
            ],
            "type": "pubkey"
          },
          {
            "name": "share_bps",
            "docs": [
              "Share of the vault in basis points (100% = 10000 bps)."
            ],
            "type": "u16"
          },
          {
            "name": "encrypted_secret_cid",
            "docs": [
              "IPFS CID of the per-heir encrypted secret payload."
            ],
            "type": "bytes"
          },
          {
            "name": "is_claimed",
            "docs": [
              "Whether this beneficiary has claimed their inheritance."
            ],
            "type": "bool"
          },
          {
            "name": "claimed_at",
            "docs": [
              "Unix timestamp of when the claim was made (0 if unclaimed)."
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "BeneficiaryRemoved",
      "docs": [
        "Emitted when a beneficiary is removed from a vault."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "wallet",
            "type": "pubkey"
          },
          {
            "name": "recovered_shares",
            "type": "u16"
          },
          {
            "name": "total_shares",
